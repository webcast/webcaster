{
  "name": "@webcast.js/webcaster",
  "version": "1.0.0",
  "description": "Browser-based streaming client for the webcast protocol: a reusable mixing and streaming core, and a DJ interface built on it.",
  "homepage": "https://github.com/webcast/webcaster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webcast/webcaster.git"
  },
  "keywords": [
    "webcast",
    "streaming",
    "audio",
    "mixer",
    "mediarecorder",
    "liquidsoap",
    "icecast"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/core/mixer.d.ts",
      "default": "./dist/core/mixer.js"
    }
  },
  "files": [
    "dist/core"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "serve": "python3 -m http.server 8000",
    "test": "tsc && node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@webcast.js/socket": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
